#!/usr/bin/env python3
"""harness — el estado del trabajo autónomo, y el dispatcher que lo mueve.

    harness status                  el contexto por defecto
    harness status --context work   uno solo
    harness status --all            todos juntos, para el vistazo de la mañana
    harness status -q               sólo lo accionable (sin la tabla de readiness)
    harness status --since FECHA    el resumen desde esa fecha (YYYY-MM-DD o ISO);
                                    no mueve la marca de "última vez que miré"
    harness status --json           el snapshot completo, parseable
    harness decisions               las decisiones de todos los contextos:
                                    ADRs por repo + notas de la vault
    harness decisions --json        lo mismo, parseable

    harness quota                   la cuota de Claude, medida leyendo las
                                    sesiones locales (~/.claude/projects)
    harness quota --projects PATH   otra carpeta de sesiones (p.ej. una fixture)
    harness quota --json            el agregado crudo, parseable
                                    Limitaciones (también en docs/harness/quota.md):
                                    es aproximado, y sólo ve las sesiones de este
                                    usuario de esta máquina —ni otros dispositivos
                                    ni otros usuarios.

    harness run                     lanza la frontera del contexto por defecto
    harness run --max 2             tope de tickets en paralelo (24 GB: dos)
    harness run --kind pi           pi | claude | codex | ...
    harness run --model xai/grok    modelo nativo del agente (opcional)
    harness run --log PATH          dónde va el log JSONL de eventos

v0 deliberadamente chico: NO es una app, es un script que imprime. La idea es vivir
con él dos semanas y recién ahí especificar el dashboard de verdad, con datos de uso
en vez de suposiciones. Ver ../PLAN.md §"centralizar" y §11 para `run`.

Este archivo es sólo el pegamento: config -> adapters -> snapshot -> render ->
stdout, y para `run`: config -> adapters -> dispatcher. Lo que hay que testear
vive en `harness/snapshot.py` y `harness/dispatch.py`. `decisions` es el mismo
pegamento contra `harness/decisions.py`: los ADRs de cada repo (`docs/adr/`) más
las notas de `decisiones/` de la vault del contexto, con la fuente de cada
resultado. La vault se lee, no se administra, y la memoria de Claude no entra:
es cómo trabajar con Tomás, no lo que aprende él.

Los contextos —repos, tracker, autonomía, presupuesto, vault— se declaran en
~/.config/harness/config.json, fuera del repo porque ahí van las credenciales. Sin
ese archivo corre con la config de arranque (ver `harness/config.py`). `status`
escribe una sola cosa: la marca de "última vez que miré" junto al log de
eventos (~/.local/state/harness/, o XDG_STATE_HOME), que abre el resumen de
la mañana (ticket #7). `run` además deja el log JSONL de eventos.

Con HARNESS_OFFLINE=1 corre en modo sin adaptadores: sin llamadas de red ni de
gh/herdr. El gate lo usa para que el humo del CLI sea hermético. `run` no existe
en ese modo: un dispatcher sin mundo no es un dispatcher.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from harness import adapters  # noqa: E402
from harness.adapters import (adr_files, collect, load_config, openrouter_credits,
                              repo_paths, vault_decision_files)  # noqa: E402
from harness.config import ConfigError  # noqa: E402
from harness.decisions import (as_list, decisions_for, render_decisions)  # noqa: E402
from harness.dispatch import (DispatchSpec, Dispatcher, EventLog, Job, cosechar)  # noqa: E402
from harness.render import render  # noqa: E402
from harness.quota import (agregar, as_dict as quota_as_dict, leer_sesiones,  # noqa: E402
                           render_quota, resumen_evento)
from harness.snapshot import as_dict, snapshot  # noqa: E402
from harness.summary import (PrAbierto, Resumen, construir, filtrar,  # noqa: E402
                             guardar_marca, as_dict as resumen_as_dict,
                             leer_eventos, leer_marca, parse_fecha)

# Modo sin adaptadores: sin red ni dependencias externas (OpenRouter, gh, herdr).
OFFLINE = os.environ.get("HARNESS_OFFLINE") == "1"


def build_parser():
    p = argparse.ArgumentParser(prog="harness",
                                description=__doc__.splitlines()[0],
                                epilog=(
                                    "quota: las dos limitaciones (ver también "
                                    "docs/harness/quota.md): es aproximado, y "
                                    "sólo ve las sesiones de Claude Code de este "
                                    "usuario de esta máquina —no ve otros "
                                    "dispositivos ni otros usuarios de la máquina."),
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", nargs="?", default="status",
                   choices=["status", "decisions", "run", "report", "quota"],
                   help="status (la pantalla), decisions (las decisiones), "
                        "run (el dispatcher de la frontera) o "
                        "quota (la cuota de Claude por sesiones locales)")
    p.add_argument("--context", metavar="NOMBRE",
                   help="un contexto en vez del de por defecto")
    p.add_argument("--all", action="store_true", dest="todos",
                   help="todos los contextos juntos")
    p.add_argument("-q", "--quiet", action="store_true",
                   help="sólo lo accionable: sin la tabla de readiness")
    p.add_argument("--since", metavar="FECHA", default="",
                   help="status: el resumen desde esa fecha (YYYY-MM-DD o ISO "
                        "8601) en vez de desde la última vez que se miró; "
                        "no mueve la marca")
    p.add_argument("--json", action="store_true", dest="como_json",
                   help="el snapshot completo en JSON, en vez de la pantalla")
    p.add_argument("--max", type=int, default=2, dest="maximo",
                   help="run: tickets en paralelo (por defecto 2)")
    p.add_argument("--kind", default="pi",
                   help="run: kind de agente de herdr (por defecto pi)")
    p.add_argument("--model", default="",
                   help="run: modelo nativo del agente (opcional)")
    p.add_argument("--log", default="",
                   help="run: dónde va el log JSONL de eventos")
    p.add_argument("--projects", default="",
                   help="quota: carpeta de sesiones (por defecto "
                        "~/.claude/projects)")
    return p


def decision_groups(contexts):
    """`[(nombre, [Decision])]`: los ADRs de cada repo más las notas de la
    vault. Todo es disco local: corre igual con o sin adaptadores."""
    groups = []
    for c in contexts:
        repos = [(p.name, adr_files(p)) for p in repo_paths(c.repos)]
        groups.append((c.name, decisions_for(c.name, repos,
                                             vault_decision_files(c.vault))))
    return groups


def main(argv=None):
    """Devuelve el código de salida. 2 = la config está mal o el modo no sirve."""
    args = build_parser().parse_args(sys.argv[1:] if argv is None else argv)
    try:
        contexts = load_config().select(args.context, todos=args.todos)
    except ConfigError as e:
        sys.stderr.write(f"harness: {e}\n")
        return 2

    if args.command == "decisions":
        groups = decision_groups(contexts)
        if args.como_json:
            json.dump({"decisions": as_list([d for _, ds in groups for d in ds])},
                      sys.stdout, indent=2, ensure_ascii=False, sort_keys=True)
            sys.stdout.write("\n")
        else:
            sys.stdout.write(render_decisions(groups, color=sys.stdout.isatty()))
        return 0
    if args.command == "quota":
        return quota_main(args, contexts)
    if args.command == "run":
        return run_main(args, contexts)

    snap = snapshot(collect(contexts, offline=OFFLINE))
    if args.since and parse_fecha(args.since) is None:
        sys.stderr.write("harness: --since inválido: se espera YYYY-MM-DD o ISO "
                         "8601 (p.ej. 2026-08-21)\n")
        return 2
    resumen = resumen_de(args, snap)
    if args.command == "report":
        # El reporte consume el MISMO dict que emite --json: es el contrato que el
        # spec fijó entre el núcleo y cualquier frontend. Si mañana la web se escribe
        # en otro lenguaje, consume esto y no las internas.
        from harness.report import render_html
        data = as_dict(snap)
        data["resumen"] = resumen_as_dict(resumen)
        sys.stdout.write(render_html(data))
        return 0
    if args.como_json:
        data = as_dict(snap)
        data["resumen"] = resumen_as_dict(resumen)
        json.dump(data, sys.stdout, indent=2, ensure_ascii=False, sort_keys=True)
        sys.stdout.write("\n")
    else:
        sys.stdout.write(render(snap, quiet=args.quiet, color=sys.stdout.isatty(),
                                resumen=resumen))
    return 0


def quota_main(args, contexts):
    """`harness quota`: la cuota de Claude medida sobre las sesiones locales
    (la misma fuente que /usage). Deja una línea en el log de eventos para
    que el histórico quede junto a todo lo demás; offline, sin efectos de
    lado, como el resto del CLI."""
    raices = [Path(c.repos.root).expanduser() for c in contexts]
    projects = (Path(args.projects).expanduser() if args.projects
                else Path.home() / ".claude" / "projects")
    agg = agregar(leer_sesiones(projects), raices)
    if args.como_json:
        json.dump(quota_as_dict(agg), sys.stdout, indent=2, ensure_ascii=False,
                  sort_keys=True)
        sys.stdout.write("\n")
    else:
        sys.stdout.write(render_quota(agg))
    if not OFFLINE:
        log = EventLog(_estado_dir() / "harness" / "events.jsonl", "harness")
        log.write("quota", "quota", resumen_evento(agg))
    return 0


def _ahora_str():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def resumen_de(args, snap):
    """El resumen de la mañana: el log de eventos desde la última vez que se
    miró (o desde `--since`), más los PRs abiertos que trae el snapshot.

    La marca vive junto al log y se actualiza con cada vista; `--since` mira
    otro período a propósito y no la mueve. Offline no hay resumen ni marca:
    el gate no debe tener efectos de lado.
    """
    if OFFLINE:
        return Resumen(estado="offline")
    base = _estado_dir() / "harness"
    log_path, mark_path = base / "events.jsonl", base / "last_viewed"
    desde_dt = parse_fecha(args.since) if args.since else leer_marca(mark_path)
    eventos = filtrar(leer_eventos(log_path), desde_dt)
    prs = [PrAbierto(repo=r.name, number=p.number, title=p.title)
          for ctx in snap.contexts for r in ctx.repos for p in r.prs]
    if not args.since:
        guardar_marca(mark_path, _ahora_str)
    return construir(eventos, prs,
                     desde=None if desde_dt is None else _iso_utc(desde_dt),
                     hasta=_ahora_str())


def _iso_utc(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _estado_dir():
    xdg = os.environ.get("XDG_STATE_HOME")
    return Path(xdg).expanduser() if xdg else Path.home() / ".local" / "state"


def _creditos_usado():
    """Cuánto se llevó usado OpenRouter, para medir el costo de la corrida."""
    data = openrouter_credits()
    try:
        return float(data["total_usage"])
    except (TypeError, KeyError, ValueError):
        return None


def run_main(args, contexts):
    """`harness run`: la frontera desbloqueada, en worktrees y panes aislados,
    con tope de paralelismo, todo anotado en el log JSONL de eventos."""
    log_path = (Path(args.log).expanduser() if args.log
                else _estado_dir() / "harness" / "events.jsonl")
    for ctx in contexts:
        # Un contexto manual no delega: este comando no toma nada solo.
        if ctx.autonomy == "manual":
            sys.stdout.write('harness: contexto "{}": autonomía manual, '
                             'este comando no toma nada solo\n'.format(ctx.name))
            continue
        if OFFLINE or os.environ.get("HERDR_ENV") != "1":
            sys.stderr.write("harness: run necesita adaptadores y una sesión de "
                             "herdr (sin HARNESS_OFFLINE, con HERDR_ENV=1)\n")
            return 2
        snap = snapshot(collect([ctx]))
        log = EventLog(log_path, ctx.name)
        jobs = []
        for r in snap.contexts[0].repos:
            if not r.slug:
                continue
            cosechar(r.slug, adapters.run, log)
            # Sin gate no hay nada que esté "verde": no se despacha el repo.
            if not r.ready.get("gate"):
                continue
            for i in r.frontier:
                jobs.append(Job(repo=r.name, repo_path=r.path, slug=r.slug,
                                issue=i.number))
        if not jobs:
            sys.stdout.write('harness: "{}": nada en la frontera\n'.format(ctx.name))
            continue
        spec = DispatchSpec(contexto=ctx.name, max_parallel=args.maximo,
                            kind=args.kind, model=args.model)
        disp = Dispatcher(spec, log, run_cmd=adapters.run,
                          credits=_creditos_usado
                          if ctx.budget.provider == "openrouter" else None)
        resultados = disp.dispatch(jobs)
        for j in resultados:
            estado = "OK       " if j.estado == "hecho" else "ABANDONADO"
            detalle = j.motivo if j.estado != "hecho" else "PR abierto (gate verde)"
            sys.stdout.write("  {} #{}/{} {}\n".format(estado, j.issue, j.repo, detalle))
        sys.stdout.write("harness: log de eventos {}\n".format(log.path))
    return 0


if __name__ == "__main__":
    sys.exit(main())
