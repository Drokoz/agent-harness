#!/usr/bin/env python3
"""harness — el estado del trabajo autónomo, y el dispatcher que lo mueve.

    harness status                  el contexto por defecto
    harness status --context work   uno solo
    harness status --all            todos juntos, para el vistazo de la mañana
    harness status -q               sólo lo accionable (sin la tabla de readiness)
    harness status --since FECHA    el resumen desde esa fecha (YYYY-MM-DD o ISO);
                                    no mueve la marca de "última vez que miré"
    harness status --json           el snapshot completo, parseable
    harness decisions               las decisiones de todos los contextos:
                                    ADRs por repo + notas de la vault
    harness decisions --json        lo mismo, parseable

    harness quota                   la cuota de Claude, medida leyendo las
                                    sesiones locales (por defecto las de este
                                    usuario: ~/.claude/projects)
    harness quota --projects RUTAS  otra(s) carpeta(s) de sesiones, separadas
                                    por coma (p.ej. una fixture, otro usuario
                                    de la máquina)
    harness quota --json            el agregado (crudo + ponderado), parseable
                                    Limitaciones (también en docs/harness/quota.md):
                                    es aproximado, y por defecto sólo ve las
                                    sesiones de este usuario de esta máquina —
                                    ni otros dispositivos ni otros usuarios.
                                    Con `--projects` (o `quota.projects` en
                                    config) se declaran varias fuentes; una que
                                    no se pueda leer se salta y el total se
                                    marca como piso (≥).

    harness costo                   el costo real por peldaño de la escalera
                                    (#96) y su tasa de éxito: cruza las sesiones
                                    de pi (el costo por mensaje, #90) contra el
                                    log de eventos (quién lo intentó, qué cerró).
                                    Todo disco local: igual sin adaptadores
    harness costo --json            el desglose por ticket y por intento, el
                                    agregado por peldaño y los tokens crudos,
                                    parseable
    harness costo --sessions RUTA   otra carpeta de sesiones de pi (por
                                    defecto ~/.pi/agent/sessions); el log se
                                    apunta con --log como en `run`

    harness run                     lanza la frontera del contexto por defecto;
                                    cada ticket corre en el peldaño de la escalera
                                    de reintentos que le toca (#38): --kind/--model
                                    son sólo el fallback de un ticket sin peldaño
    harness run --max 2             tope de tickets en paralelo (24 GB: dos)
    harness run --max-tickets 4     tope de tickets en la tanda, sin tocar
                                    etiquetas (#68); el presupuesto ya da el
                                    suyo: costo medio del historial + margen
    harness run --only 38,47        despachar tickets puntuales sin tocar
                                    etiquetas (#68)
    harness run --margen 0.10       colchón en USD: no se arranca un ticket si
                                    lo que queda no cubre el costo medio más
                                    el margen (#68)
    harness run --kind pi           fallback: pi | claude | codex | ...
    harness run --model xai/grok    fallback: modelo nativo del agente (opcional)
    harness run --log PATH          dónde va el log JSONL de eventos
    harness run -q                  sin la salida en vivo de eventos (#81):
                                    el log JSONL y el listado final no cambian
    harness run --loop              el bucle de la noche (#88): repite la
                                    pasada hasta que corta el piso de
                                    créditos, el tope de pasadas o el freno;
                                    la frontera se recalcula entre pasadas;
                                    la espera vacía se alarga sola (5m, 10m,
                                    20m, 30m) y antes de cada barrido
                                    pregunta barato "¿cambió algo?" (#114)
    harness run --loop --freno F    archivo que, si aparece, frena el bucle

    harness maintain                el mantenedor de conflictos (#56): recorre
                                    los PRs abiertos, y los que no son mergeables
                                    los resuelve en un worktree aislado, con el
                                    prompt de resolver (no de implementar). Corre
                                    antes que los tickets nuevos: `harness run`
                                    lo procesa primero, y acá solo, da igual

    harness proponer                el generador y el juez de trabajo nuevo
                                    (#115): el generador (peldaño barato) mira
                                    el código y el historial de issues y propone;
                                    el harness valida (evidencia real, dedup
                                    contra abiertos Y cerrados, tope) y abre a
                                    needs-triage; el juez (caro, adversarial)
                                    decide qué pasa la barra. Devuelve qué abrió
                                    y qué promovió; cero promovidos no es un error
    harness proponer --max-propuestas N  tope duro de issues nuevos por
                                    corrida (por defecto 5)
    harness proponer --juez-qwen    el juez corre entero en Qwen (peldaño 2) en
                                    vez de en Claude: si la semana viene
                                    ajustada
    harness proponer --piso-cuota F  fracción del tope semanal de cuota (0-1,
                                    por defecto 0.25): sin más de eso restante,
                                    el juez no corre en Claude

    harness ideas                 el agente semanal (#117): cruza los repos
                                    del contexto y busca qué está YA construido
                                    que otro rubro chileno pagaría. Un modelo
                                    bueno (Claude por defecto, `--opus` para
                                    subir) mira el código, y el harness valida
                                    (evidencia que se puede ir a leer, dedup
                                    contra la vault, tope de notas) y escribe
                                    una nota por idea en `vault/ideas/`. No
                                    abre issues: no es trabajo, es material
                                    para decidir
    harness ideas --max-ideas N   tope duro de notas por corrida (por defecto 3)
    harness ideas --forzar        correr aunque la última haya sido hace menos
                                    de 7 días (el ritmo es semanal, no de cada
                                    noche)
    harness ideas --opus          el agente corre en Opus en vez de en Sonnet
    harness doctor                la salud de la máquina (#126): si el routing
                                    de OpenRouter que el repo declara está
                                    puesto en ~/.pi/agent/models.json, y qué
                                    proveedores de atrás tienen evidencia de
                                    error en las sesiones. Todo disco local:
                                    igual offline
    harness doctor --fix          aplica el routing declarado a models.json
                                    (en vez de editar el JSON a mano); el resto
                                    del archivo (apiKey, otros providers) se
                                    preserva

`harness run --loop` lo llama solo: cuando la frontera queda vacía, en vez de
sólo esperar, corre una pasada de `proponer` (una vez por bucle; `--sin-proponer`
lo desactiva).

v0 deliberadamente chico: NO es una app, es un script que imprime. La idea es vivir
con él dos semanas y recién ahí especificar el dashboard de verdad, con datos de uso
en vez de suposiciones. Ver ../PLAN.md §"centralizar" y §11 para `run`.

Este archivo es sólo el pegamento: config -> adapters -> snapshot -> render ->
stdout, y para `run`: config -> adapters -> dispatcher. Lo que hay que testear
vive en `harness/snapshot.py` y `harness/dispatch.py`. `decisions` es el mismo
pegamento contra `harness/decisions.py`: los ADRs de cada repo (`docs/adr/`) más
las notas de `decisiones/` de la vault del contexto, con la fuente de cada
resultado. La vault se lee, no se administra, y la memoria de Claude no entra:
es cómo trabajar con Tomás, no lo que aprende él.

Los contextos —repos, tracker, autonomía, presupuesto, vault— se declaran en
~/.config/harness/config.json, fuera del repo porque ahí van las credenciales. Sin
ese archivo corre con la config de arranque (ver `harness/config.py`). `status`
escribe una sola cosa: la marca de "última vez que miré" junto al log de
eventos (~/.local/state/harness/, o XDG_STATE_HOME), que abre el resumen de
la mañana (ticket #7). `run` además deja el log JSONL de eventos.

Con HARNESS_OFFLINE=1 corre en modo sin adaptadores: sin llamadas de red ni de
gh/herdr. El gate lo usa para que el humo del CLI sea hermético. `run` no existe
en ese modo: un dispatcher sin mundo no es un dispatcher.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
from dataclasses import replace
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from harness import adapters  # noqa: E402
from harness.adapters import (adr_files, collect, load_config, openrouter_credits,
                              repo_paths, slug_of, vault_decision_files)  # noqa: E402
from harness.config import ConfigError  # noqa: E402
from harness import costo  # noqa: E402
from harness import costo_pi  # noqa: E402
from harness import doctor as doctor_mod  # noqa: E402
from harness import routing as routing_mod  # noqa: E402
from harness.decisions import (as_list, decisions_for, render_decisions)  # noqa: E402
from harness.dispatch import (BucleSpec, DispatchSpec, Dispatcher, EventLog,  # noqa: E402
                              Job, Pasada, bucle, cosechar, decidir_tanda,
                              motivo_presupuesto_reloj, peldano_de,
                              skills_de, transcripcion_path)
from harness.ideas import (IDEAS_CLAUDE, IDEAS_OPUS, Ideas,  # noqa: E402
                           MAX_IDEAS_DEFAULT, debe_correr,
                           guardar_ultima_corrida, leer_ideas_vault,
                           leer_ultima_corrida)
from harness.maintain import (CONFLICTING, MantenJob, Mantener,  # noqa: E402
                              mergeable_de)
from harness.proposal import (GENERADOR, JUEZ_CLAUDE, JUEZ_QWEN,  # noqa: E402
                              MAX_PROPOSITAS_DEFAULT, Proponer,
                              decidir_peldano_juez)
from harness.render import linea_evento, render  # noqa: E402
from harness.quota import (agregar, as_dict as quota_as_dict, cuota_por_ventana,  # noqa: E402
                           fuentes_desde_spec, leer_fuentes, puntos_de_ticket,
                           render_quota, resumen_evento, semana_de)
from harness.snapshot import as_dict, snapshot  # noqa: E402
from harness.state import (costo_promedio, de_ticket, intentos, intentos_pr,  # noqa: E402
                           intentos_pr_que_escalan, intentos_que_escalan,
                           minutos_de_ticket, motivos_de_abandono,
                           motivos_de_abandono_pr, pasos, ultimo_gate_rojo,
                           ultimo_wip)
from harness.summary import (PrAbierto, Resumen, con_cuota, construir,  # noqa: E402
                             filtrar, guardar_marca, as_dict as resumen_as_dict,
                             leer_eventos, leer_marca, parse_fecha)

# El issue de un ticket, del `ref` que anota el dispatcher ("ticket/256"):
# lo que necesitan `state.pasos` y `quota.puntos_de_ticket`, que quieren el
# issue, no el PR (`Ticket.numero` es el PR — "PR #19 abierto"— no el issue).
REF_ISSUE_RE = re.compile(r"^ticket/(\d+)$")

# Modo sin adaptadores: sin red ni dependencias externas (OpenRouter, gh, herdr).
OFFLINE = os.environ.get("HARNESS_OFFLINE") == "1"


def build_parser():
    p = argparse.ArgumentParser(prog="harness",
                                description=__doc__.splitlines()[0],
                                epilog=(
                                    "quota: las dos limitaciones (ver también "
                                    "docs/harness/quota.md): es aproximado, y "
                                    "por defecto sólo ve las sesiones de Claude "
                                    "Code de este usuario de esta máquina —no "
                                    "ve otros dispositivos ni otros usuarios de "
                                    "la máquina. Con --projects (rutas separadas "
                                    "por coma) o quota.projects en config se "
                                    "declaran varias fuentes; una que no se "
                                    "pueda leer se salta, se dice cuál y por "
                                    "qué, y el total se marca como piso (≥)."),
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", nargs="?", default="status",
                   choices=["status", "decisions", "run", "maintain", "report",
                            "quota", "costo", "proponer", "ideas",
                            "doctor"],
                   help="status (la pantalla), decisions (las decisiones), "
                        "run (el dispatcher de la frontera), "
                        "maintain (el mantenedor de conflictos, #56), "
                        "quota (la cuota de Claude por sesiones locales), "
                        "costo (el costo real por peldaño, #96), "
                        "proponer (el generador y el juez de trabajo nuevo, #115), "
                        "ideas (el agente semanal de ideas, #117) "
                        "o doctor (la salud de la máquina: routing de OpenRouter, #126)")
    p.add_argument("--context", metavar="NOMBRE",
                   help="un contexto en vez del de por defecto")
    p.add_argument("--all", action="store_true", dest="todos",
                   help="todos los contextos juntos")
    p.add_argument("-q", "--quiet", action="store_true",
                   help="status: sólo lo accionable, sin la tabla de "
                        "readiness; run: sin la salida en vivo de eventos "
                        "(para cron, o para no ensuciar una salida que se "
                        "parsee: el log JSONL y el listado final no cambian)")
    p.add_argument("--since", metavar="FECHA", default="",
                   help="status: el resumen desde esa fecha (YYYY-MM-DD o ISO "
                        "8601) en vez de desde la última vez que se miró; "
                        "no mueve la marca")
    p.add_argument("--json", action="store_true", dest="como_json",
                   help="el snapshot completo en JSON, en vez de la pantalla")
    p.add_argument("--max", type=int, default=2, dest="maximo",
                   help="run: tickets en paralelo (por defecto 2)")
    p.add_argument("--max-tickets", type=int, default=None, dest="max_tickets",
                   help="run: tope de tickets en la tanda, sin tocar etiquetas "
                        "(#68); aparte del tope de presupuesto")
    p.add_argument("--only", default="",
                   help="run: despachar solo estos issues, separados por coma "
                        "(p.ej. 38,47), sin tocar etiquetas (#68)")
    p.add_argument("--margen", type=float, default=0.10,
                   help="run: colchón en USD: no se arranca un ticket si lo que "
                        "queda no cubre el costo medio más este margen "
                        "(por defecto 0.10; #68)")
    p.add_argument("--kind", default="pi",
                   help="run: fallback de kind de agente (por defecto pi); la "
                        "escalera de reintentos (#38) lo fija por ticket")
    p.add_argument("--model", default="",
                   help="run: fallback de modelo nativo (opcional); ídem --kind")
    p.add_argument("--log", default="",
                   help="run: dónde va el log JSONL de eventos")
    p.add_argument("--loop", action="store_true",
                   help="run: repite la pasada hasta que corta algo (piso de "
                        "créditos, tope de pasadas con trabajo, o el archivo "
                        "de freno); la frontera se recalcula entre pasadas (#88)")
    p.add_argument("--freno", default="",
                   help="run --loop: archivo que, si aparece, frena el bucle; "
                        "se atiende entre pasadas, nunca en medio de una")
    p.add_argument("--piso", type=float, default=3.0,
                   help="run --loop: no arranca otra pasada con menos de este "
                        "crédito restante (US$, por defecto 3.00)")
    p.add_argument("--max-pasadas", type=int, default=12, dest="max_pasadas",
                   help="run --loop: tope duro de pasadas con trabajo "
                        "(por defecto 12); nunca un bucle sin límite")
    p.add_argument("--projects", default="",
                   help="quota: carpeta(s) de sesiones separadas por coma "
                        "(por defecto ~/.claude/projects de este usuario, o la "
                        "lista que declare quota.projects en config)")
    p.add_argument("--sessions", default="",
                   help="costo: carpeta de sesiones de pi (por defecto "
                        "~/.pi/agent/sessions)")
    p.add_argument("--max-propuestas", type=int, default=MAX_PROPOSITAS_DEFAULT,
                   dest="max_propuestas",
                   help="proponer: tope duro de issues nuevos por corrida "
                        "(por defecto 5)")
    p.add_argument("--juez-qwen", action="store_true", dest="juez_qwen",
                   help="proponer: el juez corre entero en Qwen (peldaño 2) "
                        "en vez de en Claude: si la semana viene ajustada")
    p.add_argument("--piso-cuota", type=float, default=0.25,
                   dest="piso_cuota",
                   help="proponer: fracción del tope semanal de cuota (0-1, "
                        "por defecto 0.25): sin más de eso restante, el juez "
                        "no corre en Claude")
    p.add_argument("--sin-proponer", action="store_true", dest="sin_propone",
                   help="run --loop: no correr proponer con la frontera "
                        "vacía: esperar en blanco, como antes de #115")
    p.add_argument("--sin-vigilar", action="store_true", dest="sin_vigila",
                   help="run --loop: no hacer la consulta barata "
                        "'¿cambió algo?' antes de cada barrido (#114): barra "
                        "completo cada vuelta, como antes")
    p.add_argument("--max-ideas", type=int, default=MAX_IDEAS_DEFAULT,
                   dest="max_ideas",
                   help="ideas: tope duro de notas por corrida (por defecto 3)")
    p.add_argument("--opus", action="store_true",
                   help="ideas: el agente corre en Opus en vez de en Sonnet")
    p.add_argument("--forzar", action="store_true",
                   help="ideas: correr aunque la última haya sido hace menos "
                        "de 7 días (el ritmo es semanal)")
    p.add_argument("--fix", action="store_true",
                   help="doctor: aplica el routing declarado a "
                        "~/.pi/agent/models.json (#126)")
    return p


def decision_groups(contexts):
    """`[(nombre, [Decision])]`: los ADRs de cada repo más las notas de la
    vault. Todo es disco local: corre igual con o sin adaptadores."""
    groups = []
    for c in contexts:
        repos = [(p.name, adr_files(p)) for p in repo_paths(c.repos)]
        groups.append((c.name, decisions_for(c.name, repos,
                                             vault_decision_files(c.vault))))
    return groups


def main(argv=None):
    """Devuelve el código de salida. 2 = la config está mal o el modo no sirve."""
    args = build_parser().parse_args(sys.argv[1:] if argv is None else argv)
    try:
        contexts = load_config().select(args.context, todos=args.todos)
    except ConfigError as e:
        sys.stderr.write(f"harness: {e}\n")
        return 2

    if args.command == "decisions":
        groups = decision_groups(contexts)
        if args.como_json:
            json.dump({"decisions": as_list([d for _, ds in groups for d in ds])},
                      sys.stdout, indent=2, ensure_ascii=False, sort_keys=True)
            sys.stdout.write("\n")
        else:
            sys.stdout.write(render_decisions(groups, color=sys.stdout.isatty()))
        return 0
    if args.command == "quota":
        return quota_main(args, contexts)
    if args.command == "run":
        try:
            solo = _solo_de(args.only)
        except ValueError:
            sys.stderr.write("harness: --only inválido: se esperaban números "
                             "separados por coma (p.ej. 38,47)\n")
            return 2
        return run_main(args, contexts, solo)
    if args.command == "maintain":
        return maintain_main(args, contexts)
    if args.command == "costo":
        return costo_main(args)
    if args.command == "doctor":
        return doctor_main(args)
    if args.command == "proponer":
        if args.max_propuestas < 1:
            sys.stderr.write("harness: --max-propuestas tiene que ser >= 1\n")
            return 2
        if not 0 <= args.piso_cuota <= 1:
            sys.stderr.write("harness: --piso-cuota tiene que estar entre 0 y 1\n")
            return 2
        return proponer_main(args, contexts)
    if args.command == "ideas":
        if args.max_ideas < 1:
            sys.stderr.write("harness: --max-ideas tiene que ser >= 1\n")
            return 2
        return ideas_main(args, contexts)

    raw = collect(contexts, offline=OFFLINE)
    quota_registros, quota_agg = None, None
    if not OFFLINE:
        # El log de eventos da el estado `despachado` de la frontera (ticket #43).
        raw["eventos"] = leer_eventos(_estado_dir() / "harness" / "events.jsonl")
        # La cuota (#47): sesiones locales de Claude, sin red — igual que
        # `harness quota`, pero con las fuentes de la config (sin `--projects`:
        # esa bandera es de `quota`, acá no hace falta exponerla).
        raices = [Path(c.repos.root).expanduser() for c in contexts]
        quota_registros, fuentes = leer_fuentes(_rutas_sesiones(args, contexts))
        quota_agg = agregar(quota_registros, raices, fuentes=fuentes)
    snap = snapshot(raw)
    if args.since and parse_fecha(args.since) is None:
        sys.stderr.write("harness: --since inválido: se espera YYYY-MM-DD o ISO "
                         "8601 (p.ej. 2026-08-21)\n")
        return 2
    resumen = resumen_de(args, snap, contexts, quota_agg, quota_registros)
    # Un tracker que no se pudo leer (gh vencido/sin red, #130) no es una
    # frontera vacía: la pantalla lo dice arriba y el código de salida lo
    # dice a quien lo automatiza — salir 0 sobre "no se pudo leer" es la
    # familia de #91 (fallar en silencio es peor que fallar).
    ilegibles = any(r.tracker_ilegible
                    for c in snap.contexts for r in c.repos)
    code = 1 if ilegibles else 0
    if args.command == "report" or args.como_json:
        # El reporte consume el MISMO dict que emite --json: es el contrato que el
        # spec fijó entre el núcleo y cualquier frontend. Si mañana la web se escribe
        # en otro lenguaje, consume esto y no las internas.
        data = as_dict(snap)
        data["resumen"] = resumen_as_dict(resumen)
        data["cuota"] = _cuota_dict(quota_agg)
        if args.command == "report":
            from harness.report import render_html
            sys.stdout.write(render_html(data))
        else:
            json.dump(data, sys.stdout, indent=2, ensure_ascii=False, sort_keys=True)
            sys.stdout.write("\n")
        return code
    sys.stdout.write(render(snap, quiet=args.quiet, color=sys.stdout.isatty(),
                            resumen=resumen))
    return code


def _cuota_dict(quota_agg):
    """La cuota para `--json`/`report` (#47): sólo `por_dia` (la evolución
    por noche), no el agregado entero — eso ya lo tiene `harness quota`.
    `None` (offline, o sin dónde leer sesiones) se dice tal cual: la
    página lo interpreta como "sin datos" y sigue (ver `report._cuota_seccion`).
    """
    if quota_agg is None:
        return {"estado": "offline"}
    return {"estado": "ok", "por_dia": quota_agg["por_dia"]}


def _rutas_sesiones(args, contexts):
    """Los directorios de sesiones a leer (#75): `--projects` (separadas por
    coma) gana; si no, `quota.projects` de la config (con `--all`, la primera
    que haya); si no, `~/.claude/projects` de este usuario."""
    if args.projects:
        return fuentes_desde_spec(args.projects)
    for c in contexts:
        if c.quota.projects:
            return list(c.quota.projects)
    return [str(Path.home() / ".claude" / "projects")]


def quota_main(args, contexts):
    """`harness quota`: la cuota de Claude medida sobre las sesiones locales
    (la misma fuente que /usage). Deja una línea en el log de eventos para
    que el histórico quede junto a todo lo demás; offline, sin efectos de
    lado, como el resto del CLI."""
    raices = [Path(c.repos.root).expanduser() for c in contexts]
    registros, fuentes = leer_fuentes(_rutas_sesiones(args, contexts))
    agg = agregar(registros, raices, fuentes=fuentes)
    # La constante de calibración vive en config (#74), no en el código;
    # con `--all` gana la primera que haya.
    tope = next((c.quota.tope_semanal for c in contexts
                 if c.quota.tope_semanal), None)
    if args.como_json:
        json.dump(quota_as_dict(agg), sys.stdout, indent=2, ensure_ascii=False,
                  sort_keys=True)
        sys.stdout.write("\n")
    else:
        sys.stdout.write(render_quota(agg, tope_semanal=tope))
    if not OFFLINE:
        log = EventLog(_estado_dir() / "harness" / "events.jsonl", "harness")
        log.write("quota", "quota", resumen_evento(agg))
    return 0


# El arranque de ESTE proceso: para el presupuesto de reloj (#116), "la
# noche" es la corrida que está viva. Un ticket que se comió las tres
# noches anteriores empieza la de hoy con el presupuesto entero — contarlo
# sobre el log entero lo dejaba excluido para siempre (agent-harness#45,
# fuera con 1130 min contra un tope de 180 y una noche gastada en 60
# vueltas vacías).
INICIO_NOCHE = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _ahora_str():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def resumen_de(args, snap, contexts, quota_agg, quota_registros):
    """El resumen de la mañana: el log de eventos desde la última vez que se
    miró (o desde `--since`), más los PRs abiertos que trae el snapshot.

    La marca vive junto al log y se actualiza con cada vista; `--since` mira
    otro período a propósito y no la mueve. Offline no hay resumen ni marca:
    el gate no debe tener efectos de lado.

    `quota_agg`/`quota_registros` (None si offline, #47) cruzan el resumen
    contra la cuota: la semana vigente y, por ticket, el costo en las dos
    monedas y el desglose por peldaño de una escalada. Ese cruce necesita
    el historial COMPLETO del ticket (`state.pasos`), no sólo lo que cae
    en el período, así que se lee el log entero acá, aparte del filtrado.
    """
    if OFFLINE:
        return Resumen(estado="offline")
    base = _estado_dir() / "harness"
    log_path, mark_path = base / "events.jsonl", base / "last_viewed"
    desde_dt = parse_fecha(args.since) if args.since else leer_marca(mark_path)
    eventos_todos = leer_eventos(log_path)
    eventos = filtrar(eventos_todos, desde_dt)
    prs = [PrAbierto(repo=r.name, number=p.number, title=p.title)
          for ctx in snap.contexts for r in ctx.repos for p in r.prs]
    if not args.since:
        guardar_marca(mark_path, _ahora_str)
    resumen = construir(eventos, prs,
                        desde=None if desde_dt is None else _iso_utc(desde_dt),
                        hasta=_ahora_str(), resolver_pr=_resolver_pr(snap))
    if quota_agg is None:
        return resumen
    return _con_cuota(resumen, eventos_todos, contexts, quota_agg, quota_registros)


def _issue_de_ref(ref):
    """El issue de un `Ticket.ref` ("ticket/256" -> 256), o None si no
    matchea (líneas viejas, u otro formato de ref)."""
    m = REF_ISSUE_RE.match(str(ref))
    return int(m.group(1)) if m else None


def _con_cuota(resumen, eventos_todos, contexts, quota_agg, quota_registros):
    """El cruce de `resumen` contra la cuota (#47): la semana vigente, y por
    ticket, el costo en las dos monedas más el desglose por peldaño.

    Un ticket sin repo o sin issue (líneas viejas, PR sin ticket en el
    evento) no tiene con qué cruzar: se salta y se queda con lo que traía.
    """
    raices = [Path(c.repos.root).expanduser() for c in contexts]
    harness_sem, resto_sem = semana_de(quota_agg, datetime.now(timezone.utc))
    costos, cuotas, peldanos, minutos = {}, {}, {}, {}
    for t in resumen.tickets:
        issue = _issue_de_ref(t.ref)
        if t.repo is None or issue is None:
            continue
        clave = (t.repo, t.ref)
        pasos_t = pasos(eventos_todos, t.repo, issue)
        puntos = puntos_de_ticket(quota_registros, raices, t.repo, issue)
        pasos_t = [replace(p, cuota=cuota_por_ventana(puntos, p.inicio, p.fin))
                  for p in pasos_t]
        costos[clave] = sum(p.costo for p in pasos_t)
        cuotas[clave] = sum(peso for _, peso in puntos)
        peldanos[clave] = [{"attempt": p.attempt, "runner": p.runner,
                            "motivo": p.motivo, "costo": p.costo, "cuota": p.cuota,
                            "peldano": p.peldano, "clase": p.clase}
                           for p in pasos_t]
        # Los minutos de agente (#116) salen del historial completo, no
        # del período: la moneda que de verdad limita una noche es la
        # acumulada, y es la misma que presupuesta el despacho.
        minutos[clave] = de_ticket(eventos_todos, t.repo, issue).duracion_min
    return con_cuota(resumen, cuota_semana=harness_sem + resto_sem,
                     cuota_semana_harness=harness_sem, costos_por_ticket=costos,
                     cuotas_por_ticket=cuotas, peldanos_por_ticket=peldanos,
                     minutos_por_ticket=minutos)


def _resolver_pr(snap):
    """`resolver_pr` de `construir`: el repo de un ticket (nombre, no slug)
    a su estado en vivo, vía `adapters.pr_state`. Se llama sólo cuando no
    estamos offline (`resumen_de` ya cortó antes); un repo sin slug en el
    snapshot deja el ticket con lo que dice el log."""
    slugs = {r.name: r.slug for ctx in snap.contexts for r in ctx.repos if r.slug}

    def resolver(repo, numero):
        slug = slugs.get(repo)
        return adapters.pr_state(slug, numero) if slug else None
    return resolver


def _iso_utc(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _estado_dir():
    xdg = os.environ.get("XDG_STATE_HOME")
    return Path(xdg).expanduser() if xdg else Path.home() / ".local" / "state"


def _sesiones_de_pi():
    """Las costuras que leen las sesiones de pi: costo real (#90) y motivo de
    salida (#98).

    El costo se pregunta al final de la corrida y la salida al abandonar cada
    job, así que la lectura NO se puede cachear entre las dos: una sesión que
    todavía no terminó cuando se clasificó el abandono ya está escrita cuando
    se mide el costo. Se cachea sólo por llamada."""
    def costo(repo, issue, desde=None):
        return costo_pi.costo_de(costo_pi.leer_sesiones(), repo, issue, desde)

    def salida(repo, issue, desde=None):
        return costo_pi.salida_de(costo_pi.leer_sesiones(), repo, issue, desde)

    return costo, salida


def _solo_de(valor):
    """`--only 38,47` -> {38, 47}, o None si no se pidió. ValueError si no
    se entiende: el llamador lo convierte en un error de uso, no en una
    tanda vacía en silencio."""
    if not valor:
        return None
    numeros = {int(x) for x in valor.split(",") if x.strip()}
    if not numeros:
        raise ValueError(valor)
    return numeros


def _creditos_usado():
    """Cuánto se llevó usado OpenRouter, para medir el costo de la corrida."""
    data = openrouter_credits()
    try:
        return float(data["total_usage"])
    except (TypeError, KeyError, ValueError):
        return None


LINEA_VIVA = {"espera": False, "ancho": 0}


def _imprimir_evento(linea):
    """La salida en vivo de `run` (#81): cada evento del log, en una línea
    corta a stdout mientras la corrida va. Con color sólo si stdout es un
    TTY: un log redirigido a archivo queda legible. `--quiet` no inyecta
    este listener y el comportamiento es el de siempre.

    En un TTY, la línea de `espera` del bucle es la única viva (#114):
    las vueltas vacías seguidas no acumulan una línea por vuelta, se
    actualiza la misma en el sitio. En un log redirigido no hay línea que
    actualizar — el colapso lo da el bucle, que escribe una por cada
    subida de la espera, no por vuelta."""
    tty = sys.stdout.isatty()
    txt = linea_evento(linea, color=tty)
    if tty and LINEA_VIVA["espera"] and linea.get("tipo") == "espera":
        # Sobrescribe la línea anterior: `ljust` con el ancho que ya se
        # usó para no dejar colas de la línea vieja.
        ancho = max(LINEA_VIVA["ancho"], len(txt),
                    shutil.get_terminal_size((120, 24)).columns)
        sys.stdout.write("\r" + txt.ljust(ancho))
        LINEA_VIVA["ancho"] = ancho
    else:
        if tty and LINEA_VIVA["espera"]:
            # La anterior era la línea viva: se baja para no pisarla.
            sys.stdout.write("\n")
        sys.stdout.write(txt + "\n")
        LINEA_VIVA["ancho"] = (len(txt) if linea.get("tipo") == "espera"
                               else 0)
    LINEA_VIVA["espera"] = (linea.get("tipo") == "espera")
    sys.stdout.flush()


def _creditos_restantes():
    """Cuánto queda en la key de OpenRouter: total menos usado.

    Lo usan dos cosas: el tamaño de la tanda (#68), que no arranca un ticket
    si lo que queda no cubre el costo medio más el margen, y el piso del
    `--loop` (#88), que no arranca otra pasada por debajo de él. None = no se
    puede medir; sin medir, el piso no corta (los demás cortes sí)."""
    data = openrouter_credits()
    try:
        return float(data["total_credits"]) - float(data["total_usage"])
    except (TypeError, KeyError, ValueError):
        return None


def _jobs_mantenimiento(crudo, eventos_previos, spec, log, credits,
                        costo_real, salida_real):
    """Los PRs abiertos del contexto que no son mergeables, en el peldaño
    de la escalera que le toca a cada uno (#56): `runner:cheap` con
    escalada, igual que los tickets, leyendo el historial del log. Un
    repo sin gate no se mantiene: sin gate no hay forma de verificar la
    rama resuelta. Devuelve (mantenedor, jobs, parkeados)."""
    main_t = Mantener(spec, log, run_cmd=adapters.run, credits=credits,
                      costo_real=costo_real, salida_real=salida_real)
    jobs, parkeados = [], 0
    for r in crudo["contexts"][0]["repos"]:
        if not r.get("slug") or not r.get("exists", {}).get("gate"):
            continue
        for pr in r.get("prs") or []:
            numero = pr.get("number")
            branch = pr.get("headRefName") or ""
            if numero is None or not branch:
                continue
            if mergeable_de(r["slug"], numero, adapters.run) != CONFLICTING:
                continue
            escalados = intentos_pr_que_escalan(eventos_previos, r["name"], numero)
            peldano = peldano_de(escalados)
            job = MantenJob(repo=r["name"], repo_path=r.get("path", ""),
                            slug=r["slug"], pr=numero, branch=branch,
                            base=r.get("default_branch") or "main",
                            attempt=intentos_pr(eventos_previos, r["name"],
                                                numero) + 1)
            if peldano is None:
                # Escalera agotada: se anota para humano sin worktree ni
                # pane -- no hay peldaño que correr.
                main_t.parkear(job, "pr/{}".format(numero),
                               motivos_de_abandono_pr(eventos_previos,
                                                      r["name"], numero))
                parkeados += 1
                continue
            job.kind = peldano["kind"]
            job.model = peldano["model"]
            job.extra_args = tuple(peldano["extra_args"])
            jobs.append(job)
    return main_t, jobs, parkeados


def _imprimir_mantenimiento(resultados):
    for j in resultados:
        estado = "OK       " if j.estado == "resuelto" else "ABANDONADO"
        detalle = (j.motivo if j.estado != "resuelto"
                   else "PR mergeable (gate verde)")
        sys.stdout.write("  {} PR #{}/{} {}\n".format(estado, j.pr, j.repo,
                                                      detalle))


def run_main(args, contexts, solo=None):
    """`harness run`: la frontera desbloqueada, en worktrees y panes aislados,
    con tope de paralelismo, todo anotado en el log JSONL de eventos.

    El tamaño de la tanda lo decide el presupuesto (#68): costo medio del
    historial + margen contra los créditos que quedan, más los topes manuales
    `--max-tickets`/`--only`; lo que se queda fuera se anota en el log, no se
    omite en silencio.

    Con `--loop`, el bucle de la noche (#88): repite la pasada hasta que corta
    algo; sin la bandera, una sola pasada, como siempre."""
    log_path = (Path(args.log).expanduser() if args.log
                else _estado_dir() / "harness" / "events.jsonl")
    if args.loop:
        return _run_loop(args, contexts, log_path)
    for ctx in contexts:
        # Un contexto manual no delega: este comando no toma nada solo.
        if ctx.autonomy == "manual":
            sys.stdout.write('harness: contexto "{}": autonomía manual, '
                             'este comando no toma nada solo\n'.format(ctx.name))
            continue
        if OFFLINE or os.environ.get("HERDR_ENV") != "1":
            sys.stderr.write("harness: run necesita adaptadores y una sesión de "
                             "herdr (sin HARNESS_OFFLINE, con HERDR_ENV=1)\n")
            return 2
        # El intento global de cada ticket: cuántas veces quedó intentado en
        # el historial del log, más uno (ticket #35).
        eventos_previos = leer_eventos(log_path)
        log = EventLog(log_path, ctx.name,
                       listener=None if args.quiet else _imprimir_evento)
        crudo = collect([ctx])
        # El mismo log que da el historial da el estado de la frontera
        # (ticket #43): un ticket despachado no se re-despacha.
        crudo["eventos"] = eventos_previos
        snap = snapshot(crudo)
        # El tracker que no se pudo leer (#130): su frontera no está vacía,
        # se desconoce. El motivo va al log (para la mañana) y se dice cuál
        # repo falló, sin tapar a los demás: si el resto tampoco tiene
        # trabajo, no se despacha una tanda vacía — se corta con el motivo
        # y sale distinto de cero, como el freno viejo de #91 no salía 0.
        ilegibles = [r for r in snap.contexts[0].repos if r.tracker_ilegible]
        for r in ilegibles:
            log.write("corrida", "corrida",
                      "tracker ilegible: {}: no se pudo leer el tracker "
                      "(gh no contestó): la frontera de ese repo se "
                      "desconoce".format(r.name))
            sys.stdout.write('harness: "{}": {}: no se pudo leer el tracker '
                             '(gh no contestó)\n'.format(ctx.name, r.name))
        spec = DispatchSpec(contexto=ctx.name, max_parallel=args.maximo,
                            kind=args.kind, model=args.model)
        costo_de_pi, salida_de_pi = _sesiones_de_pi()
        disp = Dispatcher(spec, log, run_cmd=adapters.run,
                          credits=_creditos_usado
                          if ctx.budget.provider == "openrouter" else None,
                          costo_real=costo_de_pi, salida_real=salida_de_pi)
        # El mantenimiento va primero (#56): con PRs no mergeables la pila
        # se pudre sola si la flota sigue abriendo más sobre la misma
        # base. Mismo peldaño, mismo log, misma cola de prioridad.
        main_t, mant_jobs, mant_parkeados = _jobs_mantenimiento(
            crudo, eventos_previos, spec, log,
            credits=_creditos_usado
            if ctx.budget.provider == "openrouter" else None,
            costo_real=costo_de_pi, salida_real=salida_de_pi)
        if mant_jobs:
            _imprimir_mantenimiento(main_t.dispatch(mant_jobs))
        if mant_parkeados:
            sys.stdout.write("  ({} PR(s) parkeado(s): escalera agotada, "
                             "anotado para humano)\n".format(mant_parkeados))
        jobs, parkeados = [], 0
        candidatos = []
        for r in snap.contexts[0].repos:
            if not r.slug:
                continue
            cosechar(r.slug, adapters.run, log)
            # Sin gate no hay nada que esté "verde": no se despacha el repo.
            if not r.ready.get("gate"):
                continue
            for i in r.frontier:
                # Sólo los libres: un ticket con PR abierto, mergeado,
                # despachado o parkeado no se re-trabaja (ticket #43).
                if i.estado != "libre":
                    continue
                # El peldaño se deriva del historial del log, no de un
                # estado en memoria (#38): sobrevive reiniciar el
                # dispatcher porque se recalcula acá, de `eventos_previos`.
                escalados = intentos_que_escalan(eventos_previos, r.name, i.number)
                peldano = peldano_de(escalados)
                attempt = intentos(eventos_previos, r.name, i.number) + 1
                if peldano is None:
                    # Escalera agotada: se parkea acá mismo, sin worktree
                    # ni pane -- no hay peldaño que correr.
                    motivos = motivos_de_abandono(eventos_previos, r.name, i.number)
                    disp.parkear(
                        Job(repo=r.name, repo_path=r.path, slug=r.slug,
                            issue=i.number, attempt=attempt),
                        "ticket/{}".format(i.number), motivos)
                    parkeados += 1
                    continue
                # `--only`: los que no están en la lista no son candidatos
                # de esta tanda (sin tocar etiquetas, #68).
                if solo is not None and i.number not in solo:
                    continue
                gate_tail = (ultimo_gate_rojo(eventos_previos, r.name, i.number)
                            if peldano.get("cola_gate") else None)
                # La rama trae un commit WIP de un abandono previo (#80): el
                # prompt del intento siguiente lo dice y le deja la decisión.
                wip = ultimo_wip(eventos_previos, r.name, i.number)
                if wip is not None:
                    wip = (wip[0], wip[1],
                           str(transcripcion_path(r.path, i.number, wip[0])))
                # Los minutos de agente de ESTA noche (#116): con ellos el
                # presupuesto de reloj sabe si el ticket ya se la comió. Se
                # cuentan desde que arrancó el proceso, no sobre el log
                # entero: si no, un ticket caro nunca vuelve a entrar.
                minutos = minutos_de_ticket(eventos_previos, r.name, i.number,
                                            desde=INICIO_NOCHE)
                candidatos.append(Job(repo=r.name, repo_path=r.path, slug=r.slug,
                                      issue=i.number, attempt=attempt,
                                      kind=peldano["kind"], model=peldano["model"],
                                      extra_args=tuple(peldano["extra_args"]),
                                      # #42: las skills del ticket salen de
                                      # su body, no de la corrida.
                                      skills=skills_de(i.body),
                                      gate_tail=gate_tail, wip=wip,
                                      minutos_acumulado=minutos))
        # El tamaño de la tanda lo decide el presupuesto (#68): los
        # créditos que quedan contra el costo medio del historial, más el
        # margen, más los topes manuales. Lo que se queda fuera se anota
        # en el log, no se omite en silencio.
        if solo is not None:
            log.write("corrida", "corrida",
                      "solo: se despachan solo los issues pedidos ({})".format(
                          ",".join(str(n) for n in sorted(solo))))
        if ctx.budget.provider == "openrouter":
            creditos = _creditos_restantes()
            # El log es compartido entre contextos: el promedio se mide
            # sobre el historial de ESTE contexto, no sobre todo el archivo.
            eventos_ctx = [e for e in eventos_previos
                           if e.get("contexto") == ctx.name]
            promedio = costo_promedio(eventos_ctx)
            if promedio is None:
                log.write("corrida", "corrida",
                          "presupuesto: sin costo medio en el historial: la "
                          "tanda no se dimensiona con la plata")
            elif creditos is None:
                log.write("corrida", "corrida",
                          "presupuesto: créditos desconocidos (no se pudo "
                          "leer la key): la tanda no se dimensiona con la "
                          "plata")
            else:
                log.write("corrida", "corrida",
                          "presupuesto: quedan ${:.4f}, costo medio "
                          "${:.4f}, margen ${:.4f}".format(
                              creditos, promedio, args.margen))
        else:
            # Sin provider de créditos no hay tope por presupuesto, y se
            # dice: no es que la plata alcanzó, es que el contexto no mide
            # plata. El tope manual --max-tickets sí sigue aplicando.
            creditos, promedio = None, None
            log.write("corrida", "corrida",
                      "presupuesto: el contexto no mide créditos de "
                      "OpenRouter: el tope por presupuesto no aplica")
        decisiones = decidir_tanda(candidatos, creditos, promedio, args.margen,
                                   max_tickets=args.max_tickets,
                                   presupuesto=(ctx.budget.provider
                                                == "openrouter"),
                                   budget_reloj=spec.budget_minutos)
        for d in decisiones:
            j = d["job"]
            if d["despachar"]:
                jobs.append(j)
            else:
                log.write("fuera", "ticket/{}".format(j.issue), d["motivo"],
                          ticket="{}#{}".format(j.repo, j.issue))
                sys.stdout.write("  FUERA  #{}/{} {}\n".format(
                    j.issue, j.repo, d["motivo"]))
        if not jobs:
            extra = " ({} parkeado(s))".format(parkeados) if parkeados else ""
            if ilegibles:
                sys.stderr.write('harness: "{}": no se despacha nada: no se '
                                 'pudo leer el tracker de {}\n'.format(
                                     ctx.name, ", ".join(r.name
                                                         for r in ilegibles)))
                return 1
            sys.stdout.write('harness: "{}": nada en la frontera{}\n'.format(
                ctx.name, extra))
            continue
        resultados = disp.dispatch(jobs)
        for j in resultados:
            estado = "OK       " if j.estado == "hecho" else "ABANDONADO"
            detalle = j.motivo if j.estado != "hecho" else "PR abierto (gate verde)"
            sys.stdout.write("  {} #{}/{} {}\n".format(estado, j.issue, j.repo, detalle))
        sys.stdout.write("harness: log de eventos {}\n".format(log.path))
    return 0


def _una_pasada(args, ctx, log):
    """Una pasada sobre un contexto (el cuerpo de `run`, en un contexto):
    recalcula la frontera desde el log y GitHub, parkea los que agotaron la
    escalera y despacha los libres. Devuelve la Pasada que el bucle (#88)
    necesita para decidir si repite; la frontera se lee del disco cada vez,
    no de memoria: un ticket que se parkeó deja de entrar y uno que se
    destrabó entra."""
    if ctx.autonomy == "manual":
        sys.stdout.write('harness: contexto "{}": autonomía manual, '
                         'este comando no toma nada solo\n'.format(ctx.name))
        return Pasada(False, "autonomía manual", log=log)
    # El intento global de cada ticket: cuántas veces quedó intentado en
    # el historial del log, más uno (ticket #35).
    eventos_previos = leer_eventos(log.path)
    crudo = collect([ctx])
    # El mismo log que da el historial da el estado de la frontera
    # (ticket #43): un ticket despachado no se re-despacha.
    crudo["eventos"] = eventos_previos
    snap = snapshot(crudo)
    # El tracker que no se pudo leer (#130): la frontera se desconoce, no
    # está vacía. El motivo va al log, se dice cuál repo falló (sin tapar a
    # los demás: los legibles sí se despachan), y la pasada trae `corte`:
    # el bucle no gasta vueltas vacías contra un tracker que no va a
    # responder — corta en la primera.
    ilegibles = [r for r in snap.contexts[0].repos if r.tracker_ilegible]
    for r in ilegibles:
        log.write("corrida", "corrida",
                  "tracker ilegible: {}: no se pudo leer el tracker "
                  "(gh no contestó): la frontera de ese repo se "
                  "desconoce".format(r.name))
        sys.stdout.write('harness: "{}": {}: no se pudo leer el tracker '
                         '(gh no contestó)\n'.format(ctx.name, r.name))
    corte = ("tracker ilegible: {}".format(
                 ", ".join(r.name for r in ilegibles))
             if ilegibles else "")
    spec = DispatchSpec(contexto=ctx.name, max_parallel=args.maximo,
                        kind=args.kind, model=args.model)
    costo_de_pi, salida_de_pi = _sesiones_de_pi()
    disp = Dispatcher(spec, log, run_cmd=adapters.run,
                      credits=_creditos_usado
                      if ctx.budget.provider == "openrouter" else None,
                      costo_real=costo_de_pi, salida_real=salida_de_pi)
    jobs, parkeados = [], 0
    for r in snap.contexts[0].repos:
        if not r.slug:
            continue
        cosechar(r.slug, adapters.run, log)
        # Sin gate no hay nada que esté "verde": no se despacha el repo.
        if not r.ready.get("gate"):
            continue
        for i in r.frontier:
            # Sólo los libres: un ticket con PR abierto, mergeado,
            # despachado o parkeado no se re-trabaja (ticket #43).
            if i.estado != "libre":
                continue
            # El peldaño se deriva del historial del log, no de un
            # estado en memoria (#38): sobrevive reiniciar el
            # dispatcher porque se recalcula acá, de `eventos_previos`.
            escalados = intentos_que_escalan(eventos_previos, r.name, i.number)
            peldano = peldano_de(escalados)
            attempt = intentos(eventos_previos, r.name, i.number) + 1
            if peldano is None:
                # Escalera agotada: se parkea acá mismo, sin worktree
                # ni pane -- no hay peldaño que correr.
                motivos = motivos_de_abandono(eventos_previos, r.name, i.number)
                disp.parkear(
                    Job(repo=r.name, repo_path=r.path, slug=r.slug,
                        issue=i.number, attempt=attempt),
                    "ticket/{}".format(i.number), motivos)
                parkeados += 1
                continue
            gate_tail = (ultimo_gate_rojo(eventos_previos, r.name, i.number)
                        if peldano.get("cola_gate") else None)
            # La rama trae un commit WIP de un abandono previo (#80): el
            # prompt del intento siguiente lo dice y le deja la decisión.
            wip = ultimo_wip(eventos_previos, r.name, i.number)
            if wip is not None:
                wip = (wip[0], wip[1],
                       str(transcripcion_path(r.path, i.number, wip[0])))
            # El presupuesto de reloj (#116): un ticket que ya agotó los
            # minutos de agente de la corrida se queda fuera con su motivo
            # -- no es un abandono, no gasta peldaño -- y la próxima noche
            # lo reintenta con el presupuesto entero. Por eso los minutos
            # se cuentan desde que arrancó el proceso y no sobre el log
            # entero: contándolo todo, el ticket no volvía nunca.
            minutos = minutos_de_ticket(eventos_previos, r.name, i.number,
                                        desde=INICIO_NOCHE)
            motivo_reloj = motivo_presupuesto_reloj(minutos,
                                                    spec.budget_minutos)
            if motivo_reloj:
                log.write("fuera", "ticket/{}".format(i.number), motivo_reloj,
                          ticket="{}#{}".format(r.name, i.number))
                sys.stdout.write("  FUERA  #{}/{} {}\n".format(
                    i.number, r.name, motivo_reloj))
                continue
            jobs.append(Job(repo=r.name, repo_path=r.path, slug=r.slug,
                            issue=i.number, attempt=attempt,
                            kind=peldano["kind"], model=peldano["model"],
                            extra_args=tuple(peldano["extra_args"]),
                            # #42: las skills del ticket salen de su body.
                            skills=skills_de(i.body),
                            gate_tail=gate_tail, wip=wip,
                            minutos_acumulado=minutos))
    if not jobs:
        extra = " ({} parkeado(s))".format(parkeados) if parkeados else ""
        sys.stdout.write('harness: "{}": nada en la frontera{}\n'.format(
            ctx.name, extra))
        return Pasada(False, "nada en la frontera{}".format(extra), log=log,
                      corte=corte)
    resultados = disp.dispatch(jobs)
    for j in resultados:
        estado = "OK       " if j.estado == "hecho" else "ABANDONADO"
        detalle = j.motivo if j.estado != "hecho" else "PR abierto (gate verde)"
        sys.stdout.write("  {} #{}/{} {}\n".format(estado, j.issue, j.repo, detalle))
    sys.stdout.write("harness: log de eventos {}\n".format(log.path))
    return Pasada(True, "{} job(s)".format(len(jobs)), log=log, corte=corte)


def _vigilar_repo(slug):
    """#114: la firma barata de un repo — ¿cambió algo en sus issues?
    Una sola llamada de search, ordenada por `updated` (la API da el
    `updated_at`): etiquetar, editar o cerrar un issue mueve la firma.
    Devuelve `(total, updated_at del más reciente)`; lanza si `gh` no
    contesta, porque sin dato no hay forma de afirmar que no cambió y el
    bucle barra completo (y lo anota)."""
    out = adapters.gh_json(
        slug, ["api", "search/issues?q=repo:{}+is:issue&sort=updated"
               "&order=desc&per_page=1".format(slug)])
    if out is None:
        raise RuntimeError("gh search/issues no respondió ({})".format(slug))
    items = out.get("items") or []
    ultimo = items[0].get("updated_at") if items else None
    return (out.get("total_count"), ultimo)


def _armar_vigilar(contextos):
    """#114: el "¿cambió algo?" del bucle: una llamada de search por repo
    y vuelta, en vez de un barrido completo (config, issues, PRs, snapshot)
    cuando no hay nada nuevo. Devuelve el callable que `bucle` inyecta,
    o None cuando ningún repo tiene slug resolvable: sin firma no hay
    forma de afirmar que no cambió, y se barra siempre, como antes."""
    firmas = {}
    for c in contextos:
        for p in repo_paths(c.repos):
            slug = slug_of(p)
            if slug and slug not in firmas:
                firmas[slug] = None
    if not firmas:
        return None

    def vigilar():
        for slug, anterior in firmas.items():
            f = _vigilar_repo(slug)
            if anterior is None or f != anterior:
                firmas[slug] = f
                return True
        return False
    return vigilar


def _run_loop(args, contexts, log_path):
    """`harness run --loop` (#88): el modo bucle del CLI, en vez del
    `scripts/noche.sh` que hace lo mismo sin tests.

    El corte siempre queda en el log de eventos con su motivo, y el freno
    se atiende entre pasadas (nunca en medio de una). Un freno viejo que ya
    estaba al arrancar no puede salir 0 (#91): se leería como éxito y se
    comería la noche.
    """
    if args.freno and Path(args.freno).expanduser().exists():
        sys.stderr.write("harness: freno puesto: {}\n"
                         "rm {} para sacarlo\n".format(
                             args.freno, args.freno))
        return 2
    if OFFLINE or os.environ.get("HERDR_ENV") != "1":
        sys.stderr.write("harness: run necesita adaptadores y una sesión de "
                         "herdr (sin HARNESS_OFFLINE, con HERDR_ENV=1)\n")
        return 2
    # El piso se mide contra el mismo proveedor que la corrida cobra:
    # sin OpenRouter no hay crédito que medir, y sin medir el piso no corta.
    provider = next((c.budget.provider for c in contexts), None)
    creditos = (_creditos_restantes if provider == "openrouter" else None)
    nombre = contexts[0].name if contexts else "harness"

    def _una_corrida():
        # Una corrida nueva por pasada: su propio run_id, y la línea
        # `pasada` se anota en ella, no en una corrida fantasma.
        log = EventLog(log_path, nombre)
        trabajo, partes, corte = False, [], ""
        for ctx in contexts:
            p = _una_pasada(args, ctx, log)
            trabajo = trabajo or p.trabajo
            partes.append(p.detalle)
            if p.corte and not corte:
                corte = p.corte
        return Pasada(trabajo, "; ".join(partes), log=log, corte=corte)

    log_corriente = {"log": None}

    def ejecutar():
        p = _una_corrida()
        # El proposer de frontera vacía (#115) escribe en el log de la
        # pasada que encontró la frontera vacía, no en una corrida fantasma.
        log_corriente["log"] = p.log
        return p

    spec = BucleSpec(piso=args.piso, max_pasadas=args.max_pasadas)
    # #114: preguntar barato antes de barrer completo. Sin slug resolvable
    # (o con --sin-vigilar) no existe: cada vuelta barra completo.
    vigilar = None if args.sin_vigila else _armar_vigilar(contexts)
    # El proposer de frontera vacía (#115): la hora más barata de la máquina
    # no se gasta en preguntar si hay trabajo, se gasta en mirarlo. Corre
    # una vez por bucle; `--sin-proponer` lo desactiva.
    proposer = None
    if not args.sin_propone:
        def proposer():
            partes = [_proponer_ctx(args, ctx, log_corriente["log"])
                      for ctx in contexts]
            return "; ".join(partes)
    # El log de respaldo: las pasadas traen el suyo, pero el corte se tiene
    # que anotar aunque no haya corrido ninguna (piso bajo al arrancar).
    corte = bucle(ejecutar, spec, EventLog(log_path, nombre),
                  creditos=creditos, freno=args.freno or None,
                  proposer_vacio=proposer, vigilar=vigilar)
    sys.stdout.write("harness: bucle: corte: {}\n".format(corte))
    # Un corte por tracker ilegible no es una noche terminada: es un mundo
    # que no se pudo leer. Sale distinto de cero, como el freno viejo de
    # #91 dejó de salir 0.
    return 1 if corte.startswith("tracker ilegible") else 0


def costo_main(args):
    """`harness costo` (#96): el costo real por peldaño de la escalera y su
    tasa de éxito. Todo el dato está en disco local (sesiones de pi + log de
    eventos), así que igual que `quota` no necesita adaptadores: en modo
    offline se mira contra las sesiones del propio usuario, que es lo que el
    gate y el humo del CLI no deben romper."""
    sesiones = costo_pi.leer_sesiones(args.sessions or costo_pi.SESIONES)
    log_path = (Path(args.log).expanduser() if args.log
                else _estado_dir() / "harness" / "events.jsonl")
    eventos = leer_eventos(log_path)
    v = costo.vista(sesiones, eventos)
    if args.como_json:
        json.dump(v, sys.stdout, indent=2, ensure_ascii=False, sort_keys=True)
        sys.stdout.write("\n")
    else:
        sys.stdout.write(costo.render(v))
def doctor_main(args):
    """`harness doctor` (#126): el routing de OpenRouter, con evidencia.

    Todo disco local (declaración del repo + `~/.pi/agent/models.json` +
    sesiones de pi): corre igual offline. Sale 0 con el routing en orden,
    1 cuando no (ausente, distinto, sin-config) y 2 con la declaración
    faltante o un `--fix` que no pudo aplicar."""
    decl = routing_mod.cargar_declaracion()
    if not decl:
        sys.stderr.write("harness: sin routing declarado en el repo "
                         "(harness/routing.json)\n")
        return 2
    if args.fix:
        ok, msg = routing_mod.aplicar(decl)
        sys.stdout.write(("harness: routing " + msg + "\n" if ok
                          else "harness: " + msg + "\n"))
        if not ok:
            return 2
    modelos = routing_mod.leer_models()
    sesiones = costo_pi.leer_sesiones()
    diag = doctor_mod.diagnostico(decl, modelos, sesiones)
    sys.stdout.write(doctor_mod.render(diag, color=sys.stdout.isatty()))
    return 0 if diag["estado"] == "ok" else 1


def _peldano_juez_para(args, ctx, log, repo):
    """El peldaño del juez (#115) con su decisión anotada en el log: por
    defecto Claude —el primer consumidor rutinario de Claude dentro del
    bucle de la noche— respetando el piso de cuota (`--piso-cuota` contra
    `quota.tope_semanal`, la misma fuente que `harness quota`); sin cuota
    para gastarla, o forzado a mano (`--juez-qwen`), corre entero en Qwen."""
    usado = 0.0
    if ctx.quota.tope_semanal:
        registros, fuentes = leer_fuentes(_rutas_sesiones(args, [ctx]))
        agg = agregar(registros, [Path(ctx.repos.root).expanduser()],
                      fuentes=fuentes)
        harness_sem, resto_sem = semana_de(agg, datetime.now(timezone.utc))
        usado = harness_sem + resto_sem
    peldano, motivo = decidir_peldano_juez(args.juez_qwen,
                                           ctx.quota.tope_semanal, usado,
                                           args.piso_cuota)
    etiqueta = peldano["kind"]
    if peldano.get("model"):
        etiqueta += " " + peldano["model"]
    if peldano.get("extra_args"):
        etiqueta += " " + " ".join(peldano["extra_args"])
    log.write("proponer", "propuesta/juez",
              "juez de {} en {}: {}".format(repo, etiqueta, motivo))
    return peldano


def _proponer_ctx(args, ctx, log):
    """Una pasada de `proponer` sobre un contexto (#115): los repos con
    slug y gate —sin gate no hay frontera, y no hay contra qué proponer
    trabajo—. Devuelve el resumen en una línea, para que el bucle lo
    anote en su log; lo accionable va en el log JSONL y en pantalla."""
    if ctx.autonomy == "manual":
        return 'contexto "{}": autonomía manual, no propone nada'.format(
            ctx.name)
    crudo = collect([ctx])
    partes = []
    for r in crudo["contexts"][0]["repos"]:
        if not r.get("slug") or not r.get("exists", {}).get("gate"):
            continue
        spec = DispatchSpec(contexto=ctx.name, kind=GENERADOR["kind"],
                            model=GENERADOR["model"])
        prop = Proponer(spec, log, run_cmd=adapters.run)
        peldano_juez = _peldano_juez_para(args, ctx, log, r["name"])
        res = prop.proponer_repo(r["name"], r["slug"], r.get("path", ""),
                                 args.max_propuestas, peldano_juez)
        for d in res["detalle"]:
            sys.stdout.write("  {} {}\n".format(r["name"], d))
        partes.append("{}: {} abierta(s), {} promovida(s), {} rechazada(s), "
                      "{} descartada(s)".format(
                          r["name"], res["abiertas"], res["promovidas"],
                          res["rechazadas"], res["descartadas"]))
    return "; ".join(partes) if partes else \
        'sin repos que proponer (hacen falta slug y gate)'


def proponer_main(args, contexts):
    """`harness proponer` (#115): corre generador y juez, y devuelve qué
    abrió y qué promovió. La etiqueta `ready-for-agent` no la toca ningún
    agente: la pone el harness, y sólo con veredicto del juez."""
    log_path = (Path(args.log).expanduser() if args.log
                else _estado_dir() / "harness" / "events.jsonl")
    for ctx in contexts:
        # Un contexto manual no delega: este comando no toma nada solo.
        if ctx.autonomy == "manual":
            sys.stdout.write('harness: contexto "{}": autonomía manual, '
                             'este comando no toma nada solo\n'.format(ctx.name))
            continue
        if OFFLINE or os.environ.get("HERDR_ENV") != "1":
            sys.stderr.write("harness: proponer necesita adaptadores y una "
                             "sesión de herdr (sin HARNESS_OFFLINE, con "
                             "HERDR_ENV=1)\n")
            return 2
        log = EventLog(log_path, ctx.name,
                       listener=None if args.quiet else _imprimir_evento)
        resumen = _proponer_ctx(args, ctx, log)
        sys.stdout.write('harness: "{}": {}\n'.format(ctx.name, resumen))
        sys.stdout.write("harness: log de eventos {}\n".format(log.path))
    return 0


def ideas_main(args, contexts):
    """`harness ideas` (#117): el agente semanal. Cruza los repos del
    contexto, el modelo bueno propone, y el harness valida y escribe las
    notas en `vault/ideas/` — nunca a GitHub: no es trabajo, es material
    para decidir. El ritmo es semanal: un sello junto al log corta las
    corridas a menos de 7 días de la anterior, y `--forzar` lo salta a
    mano."""
    log_path = (Path(args.log).expanduser() if args.log
                else _estado_dir() / "harness" / "events.jsonl")
    for ctx in contexts:
        if ctx.autonomy == "manual":
            sys.stdout.write('harness: contexto "{}": autonomía manual, '
                             'este comando no toma nada solo\n'.format(ctx.name))
            continue
        if OFFLINE or os.environ.get("HERDR_ENV") != "1":
            sys.stderr.write("harness: ideas necesita adaptadores y una sesión "
                             "de herdr (sin HARNESS_OFFLINE, con HERDR_ENV=1)\n")
            return 2
        if not ctx.vault:
            sys.stderr.write('harness: contexto "{}": sin vault declarada, no '
                             'hay dónde escribir las notas\n'.format(ctx.name))
            continue
        log = EventLog(log_path, ctx.name,
                       listener=None if args.quiet else _imprimir_evento)
        stamp = (_estado_dir() / "harness" / "ideas-ultima-corrida-{}".format(
            ctx.name))
        if args.forzar:
            ok, motivo = True, "forzada a mano (--forzar)"
        else:
            ok, motivo = debe_correr(leer_ultima_corrida(stamp), _ahora_str())
        if not ok:
            log.write("ideas", "idea", "no corre: " + motivo)
            sys.stdout.write('harness: "{}": {}\n'.format(ctx.name, motivo))
            continue
        repos = [(p.name, str(p)) for p in repo_paths(ctx.repos)]
        if not repos:
            sys.stdout.write('harness: "{}": sin repos en el disco, no hay '
                             'qué mirar\n'.format(ctx.name))
            continue
        conocidas = leer_ideas_vault(Path(ctx.vault).expanduser() / "ideas")
        peldano = IDEAS_OPUS if args.opus else IDEAS_CLAUDE
        # El agente lee TODOS los repos con un modelo bueno: la fase larga y
        # callada es legítima, así que el umbral del watchdog se ensancha
        # (los 12 min del ticket se comen la lectura de los repos).
        spec = DispatchSpec(contexto=ctx.name, kind=peldano["kind"],
                            model=peldano["model"], watchdog_kill_min=45)
        ideas = Ideas(spec, log, run_cmd=adapters.run)
        log.write("ideas", "idea",
                  "ritmo semanal: {} — {} idea(s) ya en la vault, repos: {}".format(
                      motivo, len(conocidas),
                      ", ".join(n for n, _ in repos)))
        res = ideas.ideas_corrida(repos[0][0], repos[0][1], repos,
                                  ctx.vault, args.max_ideas, conocidas,
                                  extra_args=peldano.get("extra_args", ()))
        for d in res["detalle"]:
            sys.stdout.write("  {}\n".format(d))
        if res["estado"] == "hecho":
            # Un abandono no congela el ritmo semanal: se puede reintentar.
            guardar_ultima_corrida(stamp, _ahora_str())
        extra = (" (agente {} — sin sello: se puede reintentar)".format(
            res["estado"]) if res["estado"] != "hecho" else "")
        sys.stdout.write('harness: "{}": {} nota(s) escrita(s), {} '
                         'descartada(s){}\n'.format(
                             ctx.name, res["escribas"], res["descartadas"],
                             extra))
        sys.stdout.write("harness: log de eventos {}\n".format(log.path))
    return 0


def maintain_main(args, contexts):
    """`harness maintain`: la cola de mantenimiento sola (#56). Los PRs
    abiertos que no son mergeables corren en un worktree aislado por PR,
    con el prompt de resolver y la escalera de reintentos. No toca la
    frontera de tickets: eso sigue siendo de `run`."""
    log_path = (Path(args.log).expanduser() if args.log
                else _estado_dir() / "harness" / "events.jsonl")
    for ctx in contexts:
        # Un contexto manual no delega: este comando no toma nada solo.
        if ctx.autonomy == "manual":
            sys.stdout.write('harness: contexto "{}": autonomía manual, '
                             'este comando no toma nada solo\n'.format(ctx.name))
            continue
        if OFFLINE or os.environ.get("HERDR_ENV") != "1":
            sys.stderr.write("harness: maintain necesita adaptadores y una "
                             "sesión de herdr (sin HARNESS_OFFLINE, con "
                             "HERDR_ENV=1)\n")
            return 2
        eventos_previos = leer_eventos(log_path)
        log = EventLog(log_path, ctx.name)
        crudo = collect([ctx])
        crudo["eventos"] = eventos_previos
        spec = DispatchSpec(contexto=ctx.name, max_parallel=args.maximo,
                            kind=args.kind, model=args.model)
        costo_de_pi, salida_de_pi = _sesiones_de_pi()
        main_t, jobs, parkeados = _jobs_mantenimiento(
            crudo, eventos_previos, spec, log,
            credits=_creditos_usado
            if ctx.budget.provider == "openrouter" else None,
            costo_real=costo_de_pi, salida_real=salida_de_pi)
        if not jobs and not parkeados:
            sys.stdout.write('harness: "{}": nada que mantener (todos los '
                             'PRs abiertos son mergeables)\n'.format(ctx.name))
            continue
        if jobs:
            _imprimir_mantenimiento(main_t.dispatch(jobs))
        if parkeados:
            sys.stdout.write("  ({} PR(s) parkeado(s): escalera agotada, "
                             "anotado para humano)\n".format(parkeados))
        sys.stdout.write("harness: log de eventos {}\n".format(log.path))
    return 0


if __name__ == "__main__":
    sys.exit(main())
